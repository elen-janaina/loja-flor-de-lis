# Configurações do Servidor
PORT=3001
NODE_ENV=development

# Configurações do Banco de Dados (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=loja_user
DB_PASS=loja_pass
DB_NAME=loja_roupas

# Segurança (JWT) — gere um segredo local com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Bootstrap opcional de administrador somente no ambiente local ignorado pelo Git.
# Nunca preencha a senha neste arquivo de exemplo nem a envie ao GitHub.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Regras de Negócio
FRETE_FIXO=10.00
